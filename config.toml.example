# fontgres example configuration
#
# Copy to ~/.config/fontgres/config.toml, or pass --config / FONTGRES_CONFIG (a file
# named either way must exist; the default location may be absent).
# Precedence: CLI flag > FONTGRES_* env > this file > defaults.
# A list (dirs, files) is taken whole from the highest layer that sets it.
# Invalid values fail at startup naming their source.

[fonts]
# Load the fonts installed on this system. Env: FONTGRES_FONTS_SYSTEM
# CLI: --no-system-fonts
system = true

# Directories scanned recursively for font files.
# Env: FONTGRES_FONTS_DIRS (path list, ':'-separated; ';' on Windows)
# CLI: --font-dir (repeatable)
dirs = []

# Individual font files.
# Env: FONTGRES_FONTS_FILES (path list); CLI: --font-file (repeatable)
files = []

[fonts.generic]
# Families the CSS generic names resolve to; unset keeps the built-in default.
# Env: FONTGRES_FONTS_GENERIC_SERIF, _SANS_SERIF, _CURSIVE, _FANTASY, _MONOSPACE
# serif = "Times New Roman"
# sans_serif = "Arial"
# cursive = "Comic Sans MS"
# fantasy = "Impact"
# monospace = "Courier New"

[log]
# trace|debug|info|warn|error|off. Env: FONTGRES_LOG_LEVEL
# Unset by default: the fontgres CLI then logs errors only and fontgres-mcp logs info.
# -v/-q override this; RUST_LOG overrides everything. An invalid value prints a
# warning and falls back to the binary's default.
# level = "info"

[mcp]
# Cap on the whole serialized tool result (bytes); oversized results are
# replaced with a bounded `response_too_large` error, or fail with a protocol
# error when even that cannot fit. Env: FONTGRES_MCP_MAX_RESPONSE_BYTES
# max_response_bytes = 1048576  # default: 1 MiB
